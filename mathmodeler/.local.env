# Local development environment variables for MathModeler backend.
# Source this file before running orchestrator/portal locally:
#   source .local.env && bash ../scripts/run_orchestrator.sh
# Or set these in your shell profile.

# AWS Region
export AWS_DEFAULT_REGION=us-west-2
export AWS_REGION=us-west-2

# DynamoDB Chat History Table (cross-browser session persistence)
export CHAT_HISTORY_TABLE=MathModeler-ChatHistory

# Portal admin credentials (local dev defaults)
export PORTAL_ADMIN_USER=admin
export PORTAL_ADMIN_PASSWORD=demo123
